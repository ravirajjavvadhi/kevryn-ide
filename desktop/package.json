{
  "name": "kevryn-desktop",
  "version": "1.0.1",
  "description": "KevRyn Native Desktop Runtime",
  "homepage": "https://kevryn-ide.onrender.com",
  "author": {
    "name": "KevRyn",
    "email": "admin@kevryn.com"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc",
    "watch": "tsc -w",
    "dist": "npm run build:client && npm run copy:client && npm run build && electron-builder",
    "dist:linux": "npm run build:client && npm run copy:client && npm run build && electron-builder --linux",
    "build:client": "cd ../client && npm install && npm run build",
    "copy:client": "node -e \"const fs = require('fs-extra'); fs.removeSync('./client-build'); fs.copySync('../client/build', './client-build');\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "fs-extra": "^11.3.6",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "hono": "4.13.7",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^2.0.1": "2.1.4"
  },
  "build": {
    "appId": "com.kevryn.desktop",
    "productName": "KevRyn IDE",
    "directories": {
      "output": "dist-releases"
    },
    "files": [
      "dist/**/*",
      "client-build/**/*",
      "!client-build/**/*.map",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.gypi",
      "!node_modules/**/*.cpp",
      "!node_modules/**/*.h",
      "!node_modules/**/*.cc"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kevryn",
        "repo": "desktop-releases"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development",
      "executableArgs": [
        "--no-sandbox"
      ]
    }
  }
}
